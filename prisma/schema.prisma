// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tree {
  id            String      @id
  name          String?
  type          String
  status        String      @default("available")
  description   String?
  yearlyReport  String?     @map("yearly_report")
  videos        String?
  latitude      Float?
  longitude     Float?
  width         Float?      @map("width") // ancho
  height        Float?      @map("height") // altura
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  adoptions     Adoption[]
  
  @@map("trees")
}

model User {
  id        String      @id
  name      String
  email     String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  adoptions Adoption[]
  
  @@map("users")
}

model Adoption {
  id              String    @id
  userId          String    @map("user_id")
  treeId          String    @map("tree_id")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  stripeSessionId String?   @unique @map("stripe_session_id")
  giftMessage     String?   @map("gift_message")
  status          String    @default("adopted")
  paymentStatus   String    @default("completed") @map("payment_status")
  certificateUrl  String?   @map("certificate_url")
  certificateCode String?   @unique @map("certificate_code")
  treeName        String?   @map("tree_name")
  userName        String?   @map("user_name")
  userEmail       String?   @map("user_email")
  shippingName    String?   @map("shipping_name")
  shippingAddress String?   @map("shipping_address")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  user            User      @relation(fields: [userId], references: [id])
  tree            Tree      @relation(fields: [treeId], references: [id])
  
  @@index([userId])
  @@index([treeId])
  @@map("adoptions")
}

model MessageReply {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  sender       String   // 'admin' ou 'user'
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  // Relacionamento com a mensagem original (contact_messages)
  message      ContactMessage @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("message_replies")
}

// Adicionar modelo ContactMessage se não existir
model ContactMessage {
  id         String         @id @default(uuid())
  name       String?
  email      String
  message    String
  created_at DateTime       @default(now())
  replies    MessageReply[]

  @@map("contact_messages")
}
